# Data files are regenerated by scripts/ (see BENCHMARK.md section 10); the working copy
# with all data lives in _work/julia/bench. Only small summaries are committed.
problems/*
!problems/MANIFEST.json
reference/*
!reference/CHECKS.json
results/*
!results/*_timing.json
# The repository ignores logs/ folders; these small batch logs are the evidence for
# BENCHMARK.md, so they are kept.
!logs/
logs/*
!logs/*.log
!logs/tables.md
__pycache__/
